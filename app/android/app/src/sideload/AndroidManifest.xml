<!-- The sideloaded build (release/release.sh): merged over
     src/main/AndroidManifest.xml. Adds the in-app updater's install
     permission and FileProvider (AppUpdaterModule.kt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updateprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
