// Generates the launcher icons, one per palette, from src/palettes.ts:
//
//   npm run icons     (from app/; Node 23.6+ runs TypeScript directly)
//
// For each theme it writes an adaptive icon (API 26+) with a background
// colour, a coloured foreground and the shared monochrome glyph that
// Android 13+ tints to the wallpaper ("Themed icons"), plus PNG fallbacks for
// older phones (rendered with ImageMagick). Each icon belongs to one
// <activity-alias> in AndroidManifest.xml; AppIconModule.kt switches between
// them. Re-run after changing a palette or the logo, and commit the output.
import { execFileSync } from 'node:child_process';
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { LOGO, PALETTES, THEME_NAMES, logoColors } from '../src/palettes.ts';

const RES = join(import.meta.dirname, '..', 'android', 'app', 'src', 'main', 'res');
const DENSITIES: Record<string, number> = { mdpi: 48, hdpi: 72, xhdpi: 96, xxhdpi: 144, xxxhdpi: 192 };
const HEADER = '<?xml version="1.0" encoding="utf-8"?>\n<!-- GENERATED by app/tools/gen-icons.mts from src/palettes.ts; edit those, not this. -->\n';

type Box = { x: number; y: number; w: number; h: number; r: number };

const rr = ({ x, y, w, h, r }: Box) =>
  `M${x + r},${y} h${w - 2 * r} a${r},${r} 0 0 1 ${r},${r} v${h - 2 * r} a${r},${r} 0 0 1 -${r},${r} ` +
  `h-${w - 2 * r} a${r},${r} 0 0 1 -${r},-${r} v-${h - 2 * r} a${r},${r} 0 0 1 ${r},-${r} z`;

const write = (path: string, text: string) => {
  mkdirSync(join(path, '..'), { recursive: true });
  writeFileSync(path, text);
};

// The three stripes as polygons on the canvas, before clipping to the page:
// stripe 0 below the first cut (x + y < cuts[0]), stripe 1 between the cuts,
// stripe 2 beyond. gap opens a space either side of each cut, for the
// one-colour glyph where colour can't tell the stripes apart.
function stripes(gap = 0): string[] {
  const [a, b] = LOGO.cuts;
  const lo0 = a - gap / 2, hi0 = a + gap / 2, lo1 = b - gap / 2, hi1 = b + gap / 2;
  const poly = (pts: number[][]) => 'M' + pts.map((p) => p.join(',')).join(' L') + ' z';
  return [
    poly([[0, 0], [lo0, 0], [0, lo0]]),
    poly([[0, hi0], [hi0, 0], [108, lo1 - 108], [lo1 - 108, 108]]),
    poly([[108, hi1 - 108], [108, 108], [hi1 - 108, 108]]),
  ];
}

function foregroundVector(c: ReturnType<typeof logoColors>): string {
  const bands = stripes().map((d, i) => `    <path android:fillColor="${c.stripes[i]}" android:pathData="${d}"/>`);
  return `${HEADER}<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
  <group>
    <clip-path android:pathData="${rr(LOGO.page)}"/>
${bands.join('\n')}
  </group>
${LOGO.rings.map((r) => `  <path android:fillColor="${c.rings}" android:pathData="${rr(r)}"/>`).join('\n')}
</vector>
`;
}

// One colour only (the launcher uses just its shape), so the stripes are
// told apart by gaps cut between them. Drawn a little smaller, as themed
// icons are.
function monochromeVector(): string {
  const bands = stripes(3.5).map((d) => `      <path android:fillColor="#ffffff" android:pathData="${d}"/>`);
  return `${HEADER}<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
  <group android:scaleX="0.82" android:scaleY="0.82" android:pivotX="54" android:pivotY="54">
    <group>
      <clip-path android:pathData="${rr(LOGO.page)}"/>
${bands.join('\n')}
    </group>
${LOGO.rings.map((r) => `    <path android:fillColor="#ffffff" android:pathData="${rr(r)}"/>`).join('\n')}
  </group>
</vector>
`;
}

const adaptive = (name: string) => `${HEADER}<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_bg_${name}"/>
  <foreground android:drawable="@drawable/ic_launcher_fg_${name}"/>
  <monochrome android:drawable="@drawable/ic_launcher_mono"/>
</adaptive-icon>
`;

// The legacy (pre-API 26) icon: the same art on the background, as a rounded
// square or a circle, with the 108 canvas cropped to its middle 72.
function legacySvg(c: ReturnType<typeof logoColors>, round: boolean): string {
  const shape = round ? `<circle cx="54" cy="54" r="36" fill="${c.bg}"/>` : `<rect x="18" y="18" width="72" height="72" rx="14" fill="${c.bg}"/>`;
  const bands = stripes().map((d, i) => `<path fill="${c.stripes[i]}" d="${d}"/>`).join('');
  const rings = LOGO.rings.map((r) => `<path fill="${c.rings}" d="${rr(r)}"/>`).join('');
  return `<svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="18 18 72 72"><defs><clipPath id="p"><path d="${rr(LOGO.page)}"/></clipPath></defs>${shape}<g clip-path="url(#p)">${bands}</g>${rings}</svg>`;
}

const tmp = mkdtempSync(join(tmpdir(), 'gen-icons-'));
try {
  const colors: string[] = [];
  for (const name of THEME_NAMES) {
    const c = logoColors(PALETTES[name]);
    colors.push(`  <color name="ic_bg_${name}">${c.bg}</color>`);
    write(join(RES, 'drawable', `ic_launcher_fg_${name}.xml`), foregroundVector(c));
    write(join(RES, 'mipmap-anydpi-v26', `ic_launcher_${name}.xml`), adaptive(name));
    write(join(RES, 'mipmap-anydpi-v26', `ic_launcher_${name}_round.xml`), adaptive(name));
    for (const round of [false, true]) {
      const svg = join(tmp, `${name}${round ? '_round' : ''}.svg`);
      writeFileSync(svg, legacySvg(c, round));
      for (const [d, px] of Object.entries(DENSITIES)) {
        const out = join(RES, `mipmap-${d}`, `ic_launcher_${name}${round ? '_round' : ''}.png`);
        mkdirSync(join(out, '..'), { recursive: true });
        execFileSync('magick', ['-density', '600', '-background', 'none', svg, '-resize', `${px}x${px}`, out]);
      }
    }
  }
  write(join(RES, 'drawable', 'ic_launcher_mono.xml'), monochromeVector());
  write(join(RES, 'values', 'ic_launcher_colors.xml'), `${HEADER}<resources>\n${colors.join('\n')}\n</resources>\n`);
  console.log(`wrote icons for ${THEME_NAMES.join(', ')}`);
} finally {
  rmSync(tmp, { recursive: true, force: true });
}
